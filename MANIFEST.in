include LICENSE
include README.md
include CONTRIBUTING.md
include SECURITY.md
include CONTRACT.md
include WEAKNESS_MAP.md
include calibrate.py

recursive-include data *.json *.jsonl *.md *.txt
recursive-include tools *.py
recursive-include tests *.py
# the suite reads the CI workflow (TestCiMechanical); without it the gate
# errors when run from an unpacked sdist
recursive-include .github/workflows *.yml

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
